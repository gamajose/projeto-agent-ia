APP_ENV=development
LOG_LEVEL=INFO

# Backend de segredos: env ou vault.
SECRET_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=agent-ia
VAULT_VERIFY_TLS=true
VAULT_CACHE_SECONDS=60

SSH_DEFAULT_USER=2com
SSH_DEFAULT_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=
SSH_ALLOW_AGENT=true
SSH_LOOK_FOR_KEYS=true
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60
SSH_STRICT_HOST_KEY_CHECKING=true
SSH_KNOWN_HOSTS_PATH=/home/jose/.ssh/known_hosts

# Bastion opcional. Deixe vazio quando a VM já possui rota direta aos clientes.
SSH_BASTION_HOST=
SSH_BASTION_PORT=22
SSH_BASTION_USER=
SSH_BASTION_PASSWORD=
SSH_BASTION_PRIVATE_KEY_PATH=
SSH_BASTION_PRIVATE_KEY_PASSPHRASE=

POSTGRES_DSN=postgresql+psycopg://agent_ia:CHANGE_ME@127.0.0.1:5432/agent_ia
REDIS_URL=redis://127.0.0.1:6379/1

# inline executa no processo da API; queue envia para workers distribuídos.
AGENT_EXECUTION_MODE=inline
AGENT_QUEUE_NAME=agent-ia:jobs
AGENT_RESULT_PREFIX=agent-ia:result:
AGENT_WORKER_NAME=vpn-principal
AGENT_JOB_TTL_SECONDS=86400
AGENT_QUEUE_BLOCK_SECONDS=5

AGENT_DEFAULT_MODE=propose
AGENT_API_TOKEN=
AGENT_MAX_ROUNDS=5
AGENT_MAX_COMMANDS=20
AGENT_MIN_CONFIDENCE=70
AGENT_PLAYBOOK_DIR=/opt/agent-ia/config/playbooks
AGENT_ALLOW_LEGACY_READ_COMMANDS=true

CHECKMK_API_USER=
CHECKMK_API_SECRET=
CHECKMK_WEBHOOK_TOKEN=
CHECKMK_WEBHOOK_AUTO_CORRECT=false

# Provedores acessados diretamente pelo Agent IA. São opcionais quando o
# tráfego principal passa pelo gateway OmniRoute.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Agent IA Infra
OPENROUTER_SITE_URL=

# Modelo local.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gateway OmniRoute. No Agent IA ficam apenas o token do endpoint e a URL.
# As API keys reais de Gemini, Groq, OpenAI, Anthropic etc. ficam no OmniRoute.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# Rota usada quando AI_PROVIDER=omniroute fora do menu.
OMNIROUTE_DEFAULT_ROUTE=

# Lista opcional exibida no menu. Formato:
# Nome amigável=identificador,Outro nome=outro-identificador
OMNIROUTE_ROUTES=Gemini Flash=gemini-flash,Llama rápido=llama-fast,Análise avançada=infra-advanced

# Compatibilidade com versões antigas. Prefira OMNIROUTE_DEFAULT_ROUTE.
OMNIROUTE_MODEL=

# Segunda IA obrigatória antes de executar correções.
AI_REVIEWER_PROVIDER=groq
AI_REVIEWER_REQUIRED_FOR_CORRECTIONS=true
AI_REVIEWER_MIN_CONFIDENCE=80

# Gere um valor longo e aleatório. O segredo assina aprovações temporárias.
APPROVAL_SECRET=
APPROVAL_TTL_MINUTES=30

# Integração genérica opcional com helpdesk.
HELPDESK_WEBHOOK_URL=
HELPDESK_WEBHOOK_TOKEN=
HELPDESK_PUBLISH_AUTOMATICALLY=false

# Pode apontar para o executável ou para a pasta de instalação.
CODEX_CLI_PATH=/home/jose/ia/codex
CODEX_WORKDIR=/home/jose/ia/codex
CODEX_HOME=

RECURRENCE_WARNING_COUNT=2
RECURRENCE_WARNING_DAYS=7
RECURRENCE_CRITICAL_COUNT=4
RECURRENCE_CRITICAL_DAYS=30

FILESYSTEM_WARNING_PERCENT=80
FILESYSTEM_CRITICAL_PERCENT=90
INODE_WARNING_PERCENT=80
INODE_CRITICAL_PERCENT=90
LOAD_WARNING_RATIO=1
LOAD_CRITICAL_RATIO=2
