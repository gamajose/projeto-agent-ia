[Unit]
Description=Agent IA Infra API
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=jose
Group=jose
WorkingDirectory=/opt/agent-ia
EnvironmentFile=/opt/agent-ia/.env
ExecStart=/opt/agent-ia/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/agent-ia /home/jose/.ssh
UMask=0077

[Install]
WantedBy=multi-user.target
