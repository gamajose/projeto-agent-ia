[Unit]
Description=Agent IA Infra API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agent-ia-production/current
EnvironmentFile=%h/.config/agent-ia/production.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/agent-ia-production/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
