[Unit]
Description=Agent IA Infra Worker %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agent-ia-production/current
EnvironmentFile=%h/.config/agent-ia/production.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env AGENT_WORKER_NAME=vpn-principal-%i %h/agent-ia-production/current/.venv/bin/agent-worker run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
